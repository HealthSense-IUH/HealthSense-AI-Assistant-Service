# Sao chép thành .env (không commit .env). Tên biến đặt giống Core Service để chép cấu hình Dokploy qua lại được.

# Profile: dev (có giá trị mặc định trỏ tới hạ tầng dev chung) hoặc bỏ trống để dùng application.properties
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL dùng chung với Core Service, schema "assistant"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthsense
DB_SCHEMA=assistant
DB_USERNAME=healthsense
DB_PASSWORD=healthsense

# RabbitMQ của Core Service
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=health.record.exchange
RABBITMQ_QUEUE_ASSISTANT=assistant.events.queue
RABBITMQ_HEALTH_ENABLED=false

# Anthropic Claude API: key tạo tại console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Core Service mà các tool sẽ gọi
CORE_BASE_URL=http://localhost:8080
SERVER_PORT=8081
